#!/usr/bin/env bash
# on-create フックの例: PR ブランチのマイグレーションを適用する。
# /etc/sashiki/hooks/on-create.sh に置いて実行権限を付けると有効になる。
# 受け取る環境変数は docs/DECISIONS.md と README を参照。
set -euo pipefail

echo "branch=${SASHIKI_BRANCH} port=${SASHIKI_PORT} socket=${SASHIKI_SOCKET}"

# 例: PR 番号から Git ブランチを引いてマイグレーションを流す
# PR="${SASHIKI_BRANCH#pr-}"
# WORK="${SASHIKI_STATE_DIR}/repo"
# mkdir -p "$SASHIKI_STATE_DIR"
# git clone --depth 1 --branch "refs/pull/${PR}/head" git@github.com:yourorg/app.git "$WORK"
# DATABASE_URL="mysql://root@localhost/app?socket=${SASHIKI_SOCKET}" "$WORK/bin/migrate" up
