[Unit]
Description=sashiki daemon
After=network.target zfs-mount.service

[Service]
User=sashiki
Group=sashiki
EnvironmentFile=-/etc/sashiki/sashikid.env
ExecStart=/usr/local/bin/sashikid --config /etc/sashiki/config.yaml
Restart=on-failure

[Install]
WantedBy=multi-user.target

# sashiki ユーザーには sudoers で以下だけを許可する:
#   sashiki ALL=(root) NOPASSWD: /usr/sbin/zfs, /usr/bin/systemctl start mysqld@*, /usr/bin/systemctl stop mysqld@*, /usr/bin/systemctl is-active mysqld@*
