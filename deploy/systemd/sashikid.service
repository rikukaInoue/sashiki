[Unit]
Description=sashiki daemon
After=network.target zfs-mount.service

[Service]
User=sashiki
Group=sashiki
EnvironmentFile=-/etc/sashiki/sashikid.env
ExecStart=/usr/local/bin/sashikid --config /etc/sashiki/config.yaml
Restart=on-failure

[Install]
WantedBy=multi-user.target

# sashiki ユーザーの sudoers は sashiki init が /etc/sudoers.d/sashiki に生成する
# (実呼び出し形に合わせたパス制限付き。cmd/sashiki/hardening.go 参照 #78)。
