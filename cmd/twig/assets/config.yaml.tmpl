# twigd の設定。twig init が生成した初期値。詳細は README の設定リファレンス。
listen:
  api: "127.0.0.1:8080"

state_db: /var/lib/twig/state.db
domain: twig.internal

storage:
  backend: zfs
  zfs:
    pool: {{.Pool}}
    base_dataset: {{.Pool}}/base
    branch_parent: {{.Pool}}/branches
    baseline_snapshot: baseline
    sudo: false

engine:
  type: mysql
  mysql:
    port_range: [3401, 3600]
    proxy_user: dev
    proxy_pass: dev
    env_dir: /etc/twig
    sudo: false

branches:
  name_pattern: "^[a-z0-9-]{1,32}$"
  max_branches: 50

hooks:
  dir: /etc/twig/hooks
  log_dir: /var/log/twig/hooks
