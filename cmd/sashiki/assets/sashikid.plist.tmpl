<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sashiki.sashikid</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{.SashikidBin}}</string>
    <string>--config</string>
    <string>{{.Config}}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{.Log}}/sashikid.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{.Log}}/sashikid.err.log</string>
</dict>
</plist>
