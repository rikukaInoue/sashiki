# sashikid の設定。sashiki init が生成した初期値。詳細は README の設定リファレンス。
listen:
  api: "127.0.0.1:8080"     # Web UI もここ (GET /)
  proxy: "0.0.0.0:3306"
  metrics: "127.0.0.1:9100"

state_db: /var/lib/sashiki/state.db
log_format: text   # text | json(構造化ログ。operation ログに operation_id / branch が付く)
domain: sashiki.internal

storage:
  backend: ebs-zfs
  high_watermark: 0.8        # pool使用率がこれを超えるとwarning(メトリクス)
  critical_watermark: 0.95   # これを超えるとcreate/wake/recreateを拒否
  ebs-zfs:
    pool: {{.Pool}}
    base_dataset: {{.Pool}}/base
    branch_parent: {{.Pool}}/branches
    baseline_snapshot: baseline
    sudo: false

engine:
  type: mysql
  mysql:
    port_range: [3401, 3600]
    proxy_user: dev
    proxy_pass: dev
    env_dir: /etc/sashiki
    sudo: false
  # postgres を使う場合(接続はプロキシでなく直接ポート、sashiki show <name> で確認):
  #   - listen.proxy: "" にする(プロキシは MySQL 専用)
  #   - idle_stop_after / delete_after_idle は接続追跡ができないため自動で無効化される
  #   - リモート接続には listen_addresses を広げ、base の pg_hba.conf に host 行が必要
  # postgres:
  #   port_range: [5433, 5632]
  #   bin_dir: /usr/lib/postgresql/16/bin
  #   env_dir: /etc/sashiki
  #   listen_addresses: 127.0.0.1
  #   sudo: false

branches:
  name_pattern: "^[a-z0-9-]{1,32}$"
  max_branches: 50
  lazy_create: true
  lazy_create_max_wait: 20s
  idle_stop_after: 30m      # 接続なしで mysqld を停止(データは残る、再接続で起床)
  delete_after_idle: 168h   # 7日間接続なしで削除。PR close 取りこぼしの保険
  # profile: 用途ごとに idle lifecycle を変える。branch は create --profile P で
  # 1つ持ち、reaper はその profile の閾値を使う(未設定フィールドは上の global に戻る)。
  # lease(絶対期限)は profile ではなく `sashiki create --ttl 7d` /
  # `sashiki lease renew <name> --for 7d` で明示的に付ける(使用中でも期限で回収)。
  default_profile: preview
  profiles:
    preview: { idle_stop_after: 30m, delete_after_idle: 168h }
    ci:      { idle_stop_after: 5m,  delete_after_idle: 1h }
    sandbox: { idle_stop_after: 1h,  delete_after_idle: 720h }

baseline:
  require_masked: false      # true にすると masked でない baseline の publish を拒否
  require_validated: false   # true にすると validate 未通過の publish を拒否
  validate_port: 3999
  masked_sentinel: /run/sashiki/baseline-masked

hooks:
  dir: /etc/sashiki/hooks
  log_dir: /var/log/sashiki/hooks
